<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/pageclock_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/pageclock_icon_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/pageclock_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/pageclock_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
